# Razorpay Test Mode API Keys
# Get yours: https://razorpay.com → Sign Up → Test Mode → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret (optional — configured in Razorpay Dashboard)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Google Gemini API Key (for Merchant AI agents)
GEMINI_API_KEY=your_gemini_api_key_here

# Open Source Model / OpenAI Compatible API (for Buyer AI & Simulator)
# Use any OpenAI-compatible endpoint (vLLM, Ollama, Together, Groq, etc.)
OSS_API_KEY=your_oss_api_key_here
OSS_BASE_URL=https://api.your-oss-provider.com/v1
GROQ_API_KEY=your_groq_api_key_here

# Twilio (for WhatsApp Bot — optional, used for request validation)
# Sign up: https://www.twilio.com/try-twilio
# Then join the WhatsApp Sandbox: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
